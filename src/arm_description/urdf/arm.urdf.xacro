<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_arm">

  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_radius" value="0.10"/>
  <xacro:property name="arm_length" value="0.40"/>
  <xacro:property name="arm_width" value="0.05"/>

  <material name="dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 ${arm_length / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${arm_width} ${arm_width} ${arm_length}"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
<limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
  </joint>

</robot>